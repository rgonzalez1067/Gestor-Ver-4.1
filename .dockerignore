# Dependencies — re-instaladas por la base image en deploy
**/node_modules
**/.cache
**/.parcel-cache

# Python caches
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache

# Build artifacts (regenerados)
**/build
**/dist
**/.next
**/coverage
**/.turbo

# Git
.git
.gitignore

# IDE / OS
.idea
.vscode
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test reports
test_reports/
test-results/
playwright-report/
*.test.snapshot

# Backups y dumps
db_export/
**/*.dump
**/*.bak
dump.rdb

# Archive files
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Memory / temp
memory/
.tmp/
.temp/
tmp/

# Local env overrides (las claves reales se inyectan en deploy)
**/.env.local
**/.env.development.local
**/.env.test.local
