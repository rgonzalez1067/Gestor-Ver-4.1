# Dependencies — re-instaladas por la base image en deploy
**/node_modules
**/.cache
**/.parcel-cache

# Python caches
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache

# Build artifacts (regenerados)
**/build
**/dist
**/.next
**/coverage
**/.turbo

# Git
.git
.gitignore

# IDE / OS
.idea
.vscode
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test reports
test_reports/
test-results/
playwright-report/
*.test.snapshot

# Backups y dumps
db_export/
**/*.dump
**/*.bak
dump.rdb

# Archive files
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Memory / temp
memory/
.tmp/
.temp/
tmp/

# Local env overrides (las claves reales se inyectan en deploy)
**/.env.local
**/.env.development.local
**/.env.test.local

# ============================================================================
# Archivos generados / cache de Object Storage — NO deben viajar en deploy.
# Estos PDFs y anexos viven en Emergent Object Storage; el filesystem local
# es solo un cache que se rehidrata bajo demanda. Si se incluyen, el tar
# copy del pod falla por tamaño/timeout cuando hay muchos archivos.
# ============================================================================
backend/uploads/COT-*.pdf
backend/uploads/PRY-*.pdf
backend/uploads/FACT-*.pdf
backend/uploads/NotaEntrega_*.pdf
backend/uploads/NotaEntrega_Reparacion_*.pdf
backend/uploads/attachments/
